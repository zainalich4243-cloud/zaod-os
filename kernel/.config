ZAOD_ARCH := x86_64
ZAOD_CC := gcc
ZAOD_LD := ld
ZAOD_OPT := -O3
ZAOD_CFLAGS := $(ZAOD_OPT) -std=c11 -Wall -Wextra -Werror -m64 -mcmodel=kernel -mno-red-zone -mno-sse -mno-sse2 -mno-mmx -mno-avx -msoft-float -ffreestanding -fno-builtin -fno-pic -fno-pie -fno-stack-protector
ZAOD_ASFLAGS := -m64 -mcmodel=kernel -mno-red-zone -ffreestanding -fno-pic -fno-pie
